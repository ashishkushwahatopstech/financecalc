rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if the request is from the authorized admin account
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ashishkushwaha88643@gmail.com';
    }

    // Users collection: Secure profile data
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Usernames collection: Avoid hijacking
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Blog Posts collection: Public reads for published work, owner/admin control
    match /blog_posts/{postId} {
      allow read: if (resource != null && resource.data.status == 'public' && resource.data.published == true)
                  || isAdmin()
                  || (request.auth != null && resource.data.authorUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.authorUid == request.auth.uid);
    }

    // Content manager (Banners only), announcements, and site settings: Admin-only modifications
    match /content/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Presence tracking (Active Sessions): Allow anyone to write heartbeats, anyone to read
    match /presence/{sessionId} {
      allow read, write: if true;
    }

    // Analytics (Page views, DAUs, tool usage): Allow anyone to log stats, admin-only reads
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if true;
    }
  }
}
